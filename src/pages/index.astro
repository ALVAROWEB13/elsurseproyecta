---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';

const navLinks = [
  { name: 'Nosotros', href: '#nosotros' },
  { name: 'Catálogo', href: '#catalogo' },
  { name: 'Recursos', href: '#recursos' },
  { name: 'Sedes', href: '#sedes' },
  { name: 'Reporte', href: '#reporte' },
];

const aliados = [
  { nombre: 'FUNGOMBA', territorio: 'PUTUMAYO', descripcion: 'Procesos de comunicación y memoria en comunidades del Putumayo.' },
  { nombre: 'ALAN CINE', territorio: 'CAQUETÁ', descripcion: 'Colectivo audiovisual de formación y exhibición itinerante.' },
  { nombre: 'SIEMBRA CINE', territorio: 'NARIÑO', descripcion: 'Red de formación comunitaria en producción y difusión cultural.' },
  { nombre: 'COLLECTIVO SUR', territorio: 'VALLE DEL GUAMUEZ', descripcion: 'Gestión cultural territorial y cine en espacios rurales.' },
];

const peliculas = [
  {
    titulo: 'Canto de las Aguas',
    categoria: 'Documental',
    director: 'Comunidad Amazónica',
    duracion: '45 min',
    imagen: '/images/Recurso 2.webp',
  },
  {
    titulo: 'Memorias del Monte',
    categoria: 'Ficción Comunitario',
    director: 'Colectivo Sur',
    duracion: '62 min',
    imagen: '/images/Recurso 3.webp',
  },
  {
    titulo: 'Semillas de Resistencia',
    categoria: 'Cortometraje',
    director: 'Red de Cine',
    duracion: '30 min',
    imagen: '/images/Recurso 4.webp',
  },
  {
    titulo: 'Voces de la Selva',
    categoria: 'Documental',
    director: 'Asociación Comunitaria',
    duracion: '50 min',
    imagen: '/images/Recurso 5.webp',
  },
  {
    titulo: 'Ríos de Libertad',
    categoria: 'Relato Territorial',
    director: 'Minga Audiovisual',
    duracion: '40 min',
    imagen: '/images/Recurso 6.webp',
  },
  {
    titulo: 'La Maloca Sagrada',
    categoria: 'Memoria Ancestral',
    director: 'Guardia Indígena',
    duracion: '55 min',
    imagen: '/images/Recurso 7.webp',
  },
];
---

<BaseLayout
  title="El Sur se Proyecta | Una Minga de Cine, Territorio y Comunidad"
  description="El Sur se Proyecta es una invitación a que el cine viaje de territorio en territorio, de comunidad en comunidad, de pantalla en pantalla."
>

  <!-- ==================== 1. HERO BANNER GRAN TAMAÑO ==================== -->
  <section id="hero" class="relative min-h-[96vh] lg:min-h-[105vh] flex flex-col justify-between overflow-hidden bg-sur-cream">
    
    <!-- Exact Maloca Background Image -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/hero-maloca.webp"
        alt="Comunidad El Sur se Proyecta en la maloca"
        class="w-full h-full object-cover object-center"
      />
      <!-- Top Soft Cream Gradient -->
      <div class="absolute inset-0 bg-gradient-to-b from-sur-cream via-sur-cream/60 to-transparent h-88"></div>
      <div class="absolute inset-0 bg-sur-cream/15"></div>
    </div>

    <!-- Embedded Header Navigation -->
    <header class="relative z-20 w-full pt-8 pb-4">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between">
        
        <a href="/" class="flex items-center gap-2">
          <img src="/images/logo.svg" alt="El Sur se Proyecta" class="h-10 sm:h-12 w-auto object-contain" />
        </a>

        <!-- Navigation Links in Open Sans Bold -->
        <nav class="hidden md:flex items-center gap-8">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="font-sans font-bold text-base text-sur-olive hover:text-sur-olive-dark transition-colors py-1 hover:underline underline-offset-4 decoration-2"
            >
              {link.name}
            </a>
          ))}
        </nav>

        <!-- CTA Pill Button -->
        <div class="hidden md:flex">
          <Button href="#catalogo" variant="sur-pill" size="md" className="px-6 py-2.5 text-sm font-sans font-bold">
            Ver Catálogo
          </Button>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="hero-menu-toggle"
          type="button"
          class="md:hidden p-2 rounded-xl text-sur-olive hover:bg-sur-olive/10 focus:outline-none"
          aria-label="Abrir menú"
        >
          <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <div id="hero-mobile-menu" class="hidden md:hidden bg-sur-cream/95 backdrop-blur-md px-6 py-4 mt-2 border-b border-sur-olive/10 space-y-3 shadow-lg">
        {navLinks.map((link) => (
          <a href={link.href} class="block font-sans font-bold text-base text-sur-olive">
            {link.name}
          </a>
        ))}
        <Button href="#catalogo" variant="sur-pill" size="md" className="w-full justify-center">
          Ver Catálogo
        </Button>
      </div>
    </header>

    <!-- Main Hero Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-10 pb-36 relative z-10 w-full flex-grow flex items-center">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-14 items-center w-full">
        
        <!-- Left: Large Official Logo SVG -->
        <div class="lg:col-span-5 flex justify-start items-center">
          <img
            src="/images/logo.svg"
            alt="El Sur se Proyecta Logo"
            class="w-full max-w-[380px] sm:max-w-[480px] lg:max-w-[540px] h-auto object-contain filter drop-shadow-lg select-none"
          />
        </div>

        <!-- Right: Headline, Description & CTA Button -->
        <div class="lg:col-span-7 space-y-7 max-w-2xl">
          <h1 class="font-sur-brand text-5xl sm:text-6xl lg:text-7xl text-sur-olive uppercase leading-[0.95] tracking-wide">
            UNA MINGA DE CINE,<br class="hidden sm:inline" />
            TERRITORIO Y COMUNIDAD
          </h1>

          <p class="font-sans font-normal text-lg sm:text-xl text-sur-olive/95 leading-relaxed max-w-xl">
            El Sur se Proyecta es una Invitación a que el cine viaje de territorio en territorio, de comunidad en comunidad, de pantalla en pantalla.
          </p>

          <div class="pt-2">
            <Button href="#catalogo" variant="sur-pill" size="lg" className="px-9 py-4 text-lg font-sans font-bold shadow-xl">
              Explorar Catálogo
            </Button>
          </div>
        </div>

      </div>
    </div>

    <!-- Clean Organic Wave Transition into Cyan Section -->
    <div class="relative z-20 w-full leading-none -mt-12 sm:-mt-20 pointer-events-none text-sur-cyan">
      <svg class="w-full h-auto block" viewBox="0 0 1440 120" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
        <path d="M0,32 C280,96 560,0 840,48 C1120,96 1320,24 1440,36 L1440,120 L0,120 Z" fill="currentColor"></path>
      </svg>
    </div>

  </section>

  <!-- ==================== 2. SEGUNDA SECCIÓN (SOBRE NOSOTROS - FONDO RECURSO 10.WEBP) ==================== -->
  <section id="nosotros" class="relative py-20 lg:py-28 bg-sur-cyan text-white overflow-hidden min-h-[600px] flex items-center">
    
    <!-- Background Image: Recurso 10.webp (nosotros-bg.webp) -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/nosotros-bg.webp"
        alt="Mapa y Fondo Sobre Nosotros El Sur se Proyecta"
        class="w-full h-full object-cover object-center"
      />
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        
        <!-- Left Column: Spacer so the map graphic on Recurso 10.webp is visible -->
        <div class="lg:col-span-5 hidden lg:block"></div>

        <!-- Right Column: Text Content Overlay -->
        <div class="lg:col-span-7 space-y-6">
          <span class="font-sans font-bold text-xs uppercase tracking-widest text-white/90">
            SOBRE NOSOTROS
          </span>

          <h2 class="font-sur-brand text-4xl sm:text-5xl lg:text-6xl uppercase tracking-wide leading-[0.95] text-[#F5E9D8]">
            EL SUR YA TIENE LAS HISTORIAS<br />
            AHORA LAS PROYECTAMOS JUNTXS
          </h2>

          <p class="font-sans font-normal text-white text-base sm:text-lg leading-relaxed">
            Somos una red que conecta narradorxs, exhibidorxs comunitarixs, organizaciones de base y públicos en Ecuador, Colombia y México, apostando porque historias climáticas de todos los géneros y formatos lleguen a quienes se reconocen en ellas y detonen conversaciones reales.
          </p>

          <p class="font-sans font-normal text-white/90 text-sm sm:text-base leading-relaxed">
            Nace de la alianza entre Mullu, Nodo Sur y Ambulante, con el apoyo de Doc Society. Tres organizaciones de tres países, cada una con su red, su historia y su arraigo, que decidieron construir juntas una apuesta regional que conecta narrativas climáticas, territorios y audiencias, combinando lo digital con procesos presenciales de exhibición y mediación, porque cuando una narrativa encuentra su comunidad, ese encuentro se vuelve semilla de cambio.
          </p>

          <div class="pt-2">
            <Button href="#recursos" variant="primary" size="lg" className="bg-[#1e612b] hover:bg-[#164a20] text-white font-sans font-bold border-0 px-8 py-3.5 rounded-full shadow-lg">
              Recursos y Guías
            </Button>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== 3. MANIFIESTO ROJO SECTION ==================== -->
  <section id="manifiesto" class="grid grid-cols-1 lg:grid-cols-2 bg-sur-cream">
    
    <!-- Left Photo: Community elders in jungle (manifiesto-rojo.webp) -->
    <div class="min-h-[420px] lg:min-h-[580px] relative">
      <img
        src="/images/manifiesto-rojo.webp"
        alt="Comunidad en territorio ancestral"
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Right: Vibrant Red Info Box -->
    <div class="bg-[#E3322B] text-white p-10 sm:p-14 lg:p-16 flex flex-col justify-center space-y-6">
      <span class="font-sans font-bold text-xs uppercase tracking-widest bg-white/20 px-3.5 py-1 rounded-full self-start">
        UNA RED EN MOVIMIENTO
      </span>

      <p class="font-sans font-normal text-white text-base sm:text-lg leading-relaxed">
        El cine en los territorios no es solo entretenimiento, es una herramienta de resistencia, memoria y tejido social. Creemos en un cine que no solo se contempla, sino que se camina, se platica y se sueña colectivamente.
      </p>

      <p class="font-sans font-normal text-white/90 text-base sm:text-lg leading-relaxed">
        Esta minga busca descentralizar el acceso al cine, fortaleciendo los procesos locales de comunicación comunitaria y creando pantallas donde nuestras propias historias se reconozcan.
      </p>
    </div>

  </section>

  <!-- ==================== 4. MUESTRA FOTOGRÁFICA MASONRY ==================== -->
  <section class="py-4 bg-sur-cream">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        
        <div class="md:row-span-2 rounded-2xl overflow-hidden shadow-md group">
          <img src="/images/Recurso 2.webp" alt="Minga y Territorio 1" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300 min-h-[300px]" />
        </div>

        <div class="md:col-span-2 rounded-2xl overflow-hidden shadow-md group">
          <img src="/images/noches-cine.webp" alt="Proyección en Maloca 2" class="w-full h-[280px] sm:h-[340px] object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md group">
          <img src="/images/Recurso 3.webp" alt="Taller Comunitario 3" class="w-full h-[240px] object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md group">
          <img src="/images/Recurso 4.webp" alt="Territorio Páramo 4" class="w-full h-[240px] object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>

        <div class="rounded-2xl overflow-hidden shadow-md group">
          <img src="/images/Recurso 5.webp" alt="Fauna y Naturaleza 5" class="w-full h-[220px] object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>

        <div class="md:col-span-2 rounded-2xl overflow-hidden shadow-md group">
          <img src="/images/Recurso 6.webp" alt="Río y Selva 6" class="w-full h-[220px] object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>

      </div>
    </div>
  </section>

  <!-- ==================== 5. OLIVE GREEN SECTION ==================== -->
  <section class="grid grid-cols-1 lg:grid-cols-2 bg-sur-cream">
    
    <div class="bg-sur-olive text-sur-cream p-10 sm:p-14 lg:p-16 flex flex-col justify-center space-y-6">
      <span class="font-sans font-bold text-xs uppercase tracking-widest bg-white/15 px-3.5 py-1 rounded-full self-start text-sur-cream">
        NOCHES DE CINE EN EL TERRITORIO
      </span>

      <p class="font-sans font-normal text-sur-cream/95 text-base sm:text-lg leading-relaxed">
        Organizamos proyecciones bajo las estrellas, en canchas comunitarias, quioscos y plazas principales. Cada función es un espacio festivo donde niños, jóvenes y mayores comparten historias al calor de la comunidad.
      </p>

      <p class="font-sans font-normal text-sur-cream/90 text-base sm:text-lg leading-relaxed">
        Acompañamos cada película con conversatorios y foros donde la palabra circula libremente.
      </p>
    </div>

    <div class="min-h-[400px] lg:min-h-[500px] relative">
      <img
        src="/images/Recurso 7.webp"
        alt="Proyección de cine en plaza pública"
        class="w-full h-full object-cover"
      />
    </div>

  </section>

  <!-- ==================== 6. DECORATIVE TRIBAL SYMBOLS ROW ==================== -->
  <div class="bg-sur-cream py-8 flex justify-center items-center gap-6 overflow-hidden select-none opacity-90">
    <img src="/images/Recurso 13.svg" alt="Simbolo" class="h-9 w-auto object-contain" onerror="this.style.display='none';" />
    <img src="/images/Recurso 14.svg" alt="Simbolo" class="h-9 w-auto object-contain" onerror="this.style.display='none';" />
    <img src="/images/Recurso 15.svg" alt="Simbolo" class="h-9 w-auto object-contain" onerror="this.style.display='none';" />
    <img src="/images/Recurso 16.svg" alt="Simbolo" class="h-9 w-auto object-contain" onerror="this.style.display='none';" />
    <img src="/images/Recurso 17.svg" alt="Simbolo" class="h-9 w-auto object-contain" onerror="this.style.display='none';" />
    <img src="/images/Recurso 18.svg" alt="Simbolo" class="h-9 w-auto object-contain" onerror="this.style.display='none';" />
  </div>

  <!-- ==================== 7. COLABORACIÓN / ALIADOS SECTION ==================== -->
  <section class="py-20 bg-sur-cream border-t border-sur-olive/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center space-y-3 mb-14">
        <span class="font-sans font-bold text-xs uppercase tracking-widest text-sur-olive">NUESTROS ALIADOS</span>
        <h2 class="font-sur-brand text-4xl sm:text-5xl text-sur-olive uppercase tracking-wide">
          EL SUR SE PROYECTA SE CONSTRUYE EN COLABORACIÓN
        </h2>
        <p class="font-sans font-normal text-sur-olive/80 text-base sm:text-lg leading-relaxed">
          Esta minga es posible gracias al trabajo articulado con colectivos locales, organizaciones comunitarias, instituciones culturales y gestores territoriales.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {aliados.map((aliado) => (
          <div class="bg-sur-olive text-sur-cream p-7 rounded-3xl space-y-3 flex flex-col justify-between shadow-md hover:-translate-y-1 transition-all">
            <div class="space-y-2">
              <h3 class="font-sur-brand text-3xl uppercase tracking-wide text-white">{aliado.nombre}</h3>
              <span class="font-sans font-bold text-[11px] bg-sur-green text-white px-3 py-0.5 rounded-full inline-block">
                {aliado.territorio}
              </span>
              <p class="font-sans font-normal text-xs text-sur-cream/80 leading-relaxed pt-2">
                {aliado.descripcion}
              </p>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ==================== 8. CATÁLOGO AUDIOVISUAL SECTION ==================== -->
  <section id="catalogo" class="py-20 bg-sur-cream-light border-t border-sur-olive/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="text-center max-w-2xl mx-auto mb-10 space-y-2">
        <span class="font-sans font-bold text-xs uppercase tracking-widest text-sur-olive">MUESTRA AUDIOVISUAL</span>
        <h2 class="font-sur-brand text-4xl sm:text-5xl text-sur-olive uppercase tracking-wide">
          CATÁLOGO DE PELÍCULAS
        </h2>
      </div>

      <div class="flex flex-wrap justify-center gap-2 mb-12">
        <button class="font-sans font-bold text-xs bg-sur-green text-white px-5 py-2 rounded-full">TODAS</button>
        <button class="font-sans font-bold text-xs bg-sur-cream border border-sur-olive/20 text-sur-olive hover:bg-sur-olive hover:text-white px-5 py-2 rounded-full transition-colors">DOCUMENTAL</button>
        <button class="font-sans font-bold text-xs bg-sur-cream border border-sur-olive/20 text-sur-olive hover:bg-sur-olive hover:text-white px-5 py-2 rounded-full transition-colors">FICCIÓN</button>
        <button class="font-sans font-bold text-xs bg-sur-cream border border-sur-olive/20 text-sur-olive hover:bg-sur-olive hover:text-white px-5 py-2 rounded-full transition-colors">CORTOMETRAJE</button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {peliculas.map((film) => (
          <div class="bg-sur-cream rounded-3xl overflow-hidden border border-sur-olive/15 shadow-md hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
            <div>
              <div class="aspect-[16/10] w-full overflow-hidden relative bg-slate-200">
                <img
                  src={film.imagen}
                  alt={film.titulo}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                />
                <span class="font-sans font-bold absolute top-3 left-3 bg-sur-green text-white text-[10px] px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
                  {film.categoria}
                </span>
              </div>
              <div class="p-6 space-y-2">
                <h3 class="font-sur-brand text-3xl text-sur-olive uppercase tracking-wide">{film.titulo}</h3>
                <p class="font-sans font-bold text-xs text-sur-olive/70">Director: {film.director} • {film.duracion}</p>
              </div>
            </div>
            <div class="px-6 pb-6 pt-2">
              <Button href="#catalogo" variant="sur-pill" size="sm" className="w-full justify-center font-sans font-bold">
                Ver Ficha de Película
              </Button>
            </div>
          </div>
        ))}
      </div>

      <div class="mt-12 text-center">
        <Button href="#catalogo" variant="sur-pill" size="lg" className="px-8 py-3.5 font-sans font-bold">
          Ver Catálogo Completo
        </Button>
      </div>

    </div>
  </section>

  <!-- ==================== 9. RECURSOS Y HERRAMIENTAS SECTION ==================== -->
  <section id="recursos" class="py-20 bg-sur-cream border-t border-sur-olive/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="max-w-3xl mx-auto text-center space-y-3 mb-14">
        <span class="font-sans font-bold text-xs uppercase tracking-widest text-sur-olive">RECURSOS Y DESCARGAS</span>
        <h2 class="font-sur-brand text-4xl sm:text-5xl text-sur-olive uppercase tracking-wide">
          MATERIALES PARA LA MINGA
        </h2>
        <p class="font-sans font-normal text-sur-olive/80 text-base sm:text-lg leading-relaxed">
          Descarga nuestras guías metodológicas, kits de difusión y materiales para organizar tu propia función de cine comunitario.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div class="bg-[#E66700] text-white p-8 rounded-3xl space-y-4 shadow-md flex flex-col justify-between hover:-translate-y-1 transition-all">
          <div class="space-y-2">
            <h3 class="font-sur-brand text-3xl uppercase tracking-wide">Guía de Proyección</h3>
            <p class="font-sans font-normal text-xs text-white/90 leading-relaxed">
              Paso a paso para montar funciones de cine en comunidades rurales y espacios abiertos.
            </p>
          </div>
          <Button href="#" variant="secondary" size="sm" className="bg-white text-[#E66700] hover:bg-white/90 border-0 w-full justify-center font-sans font-bold">
            Descargar PDF
          </Button>
        </div>

        <div class="bg-[#E66700] text-white p-8 rounded-3xl space-y-4 shadow-md flex flex-col justify-between hover:-translate-y-1 transition-all">
          <div class="space-y-2">
            <h3 class="font-sur-brand text-3xl uppercase tracking-wide">Manual de Mediación</h3>
            <p class="font-sans font-normal text-xs text-white/90 leading-relaxed">
              Herramientas para facilitar cineforos y conversaciones comunitarias significativas.
            </p>
          </div>
          <Button href="#" variant="secondary" size="sm" className="bg-white text-[#E66700] hover:bg-white/90 border-0 w-full justify-center font-sans font-bold">
            Descargar PDF
          </Button>
        </div>

        <div class="bg-[#E66700] text-white p-8 rounded-3xl space-y-4 shadow-md flex flex-col justify-between hover:-translate-y-1 transition-all">
          <div class="space-y-2">
            <h3 class="font-sur-brand text-3xl uppercase tracking-wide">Kit de Difusión</h3>
            <p class="font-sans font-normal text-xs text-white/90 leading-relaxed">
              Afiches editables, pancartas y piezas para redes sociales de tus funciones.
            </p>
          </div>
          <Button href="#" variant="secondary" size="sm" className="bg-white text-[#E66700] hover:bg-white/90 border-0 w-full justify-center font-sans font-bold">
            Descargar KIT (.zip)
          </Button>
        </div>
      </div>

    </div>
  </section>

  <!-- ==================== 10. REPORTE E IMPACTO SECTION ==================== -->
  <section id="reporte" class="py-20 bg-sur-cream-light border-t border-sur-olive/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
