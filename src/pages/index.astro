---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';

const filmCatalog = [
  {
    title: 'Canto de las Aguas',
    director: 'Comunidad Amazónica',
    duration: '45 min',
    category: 'Documental',
    image: '/images/Recurso 2.webp',
  },
  {
    title: 'Memorias del Monte',
    director: 'Colectivo Sur',
    duration: '62 min',
    category: 'Ficción Comunitario',
    image: '/images/Recurso 3.webp',
  },
  {
    title: 'Semillas de Resistencia',
    director: 'Red de Cine',
    duration: '30 min',
    category: 'Cortometraje',
    image: '/images/Recurso 4.webp',
  },
  {
    title: 'Voces de la Selva',
    director: 'Asociación Comunitaria',
    duration: '50 min',
    category: 'Documental',
    image: '/images/Recurso 5.webp',
  },
  {
    title: 'Ríos de Libertad',
    director: 'Minga Audiovisual',
    duration: '40 min',
    category: 'Relato Territorial',
    image: '/images/Recurso 6.webp',
  },
  {
    title: 'La Maloca Sagrada',
    director: 'Guardia Indígena',
    duration: '55 min',
    category: 'Memoria Ancestral',
    image: '/images/Recurso 7.webp',
  },
];
---

<BaseLayout
  title="El Sur se Proyecta | Una Minga de Cine, Territorio y Comunidad"
  description="El Sur se Proyecta es una Invitación a que el cine viaje de territorio en territorio, de comunidad en comunidad, de pantalla en pantalla."
>
  <!-- Hero Section -->
  <section id="hero" class="relative min-h-[88vh] flex flex-col justify-between overflow-hidden bg-sur-cream">
    
    <!-- Background Image with Gradient Overlays -->
    <div class="absolute inset-0 z-0">
      <img
        src="/images/Recurso 11.webp"
        alt="Comunidad El Sur se Proyecta en la maloca"
        class="w-full h-full object-cover object-center"
        onerror="this.onerror=null; this.src='/images/Recurso 9.webp';"
      />
      <!-- Top Soft Cream Gradient Overlay for Seamless Header Blend -->
      <div class="absolute inset-0 bg-gradient-to-b from-sur-cream via-sur-cream/70 to-transparent h-72"></div>
      <!-- Light Warm Overlay -->
      <div class="absolute inset-0 bg-sur-cream/20"></div>
    </div>

    <!-- Main Hero Content -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-28 relative z-10 w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center pt-4">
        
        <!-- Left Column: Official Logo SVG Image -->
        <div class="lg:col-span-5 flex justify-start items-center">
          <img
            src="/images/logo.svg"
            alt="El Sur se Proyecta"
            class="w-full max-w-[340px] sm:max-w-[420px] lg:max-w-[460px] h-auto object-contain filter drop-shadow-md select-none transition-transform duration-300 hover:scale-[1.02]"
          />
        </div>

        <!-- Right Column: Headline, Description & CTA -->
        <div class="lg:col-span-7 space-y-6 max-w-2xl">
          <h1 class="font-sur-brand text-4xl sm:text-5xl lg:text-6xl text-sur-olive uppercase leading-[0.95] tracking-wide">
            UNA MINGA DE CINE,<br class="hidden sm:inline" />
            TERRITORIO Y COMUNIDAD
          </h1>

          <!-- Subtitle / Body Text in Open Sans Regular -->
          <p class="font-sans font-normal text-base sm:text-lg text-sur-olive/90 leading-relaxed max-w-xl">
            El Sur se Proyecta es una Invitación a que el cine viaje de territorio en territorio, de comunidad en comunidad, de pantalla en pantalla.
          </p>

          <!-- Button in Open Sans Bold -->
          <div class="pt-2">
            <Button href="#catalogo" variant="sur-pill" size="lg" className="px-8 py-3.5 text-base font-sans font-bold">
              Explorar Catálogo
            </Button>
          </div>
        </div>

      </div>
    </div>

    <!-- Official Decorative Organic River Waves SVG (Recurso 19.svg / Recurso 12.svg) -->
    <div class="relative z-20 w-full leading-none -mt-16 sm:-mt-24 pointer-events-none">
      <img
        src="/images/Recurso 19.svg"
        alt="Olas de río El Sur se Proyecta"
        class="w-full h-auto block object-cover"
        onerror="this.onerror=null; this.src='/images/Recurso 12.svg';"
      />
    </div>

  </section>

  <!-- Nosotros / Minga Section -->
  <section id="nosotros" class="py-20 bg-sur-cream border-t border-sur-olive/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl mx-auto text-center space-y-4">
        <h2 class="font-sur-brand text-4xl sm:text-5xl text-sur-olive uppercase tracking-wide">
          Cine Itinerante y Comunitario
        </h2>
        <p class="font-sans font-normal text-base sm:text-lg text-sur-olive/80 leading-relaxed">
          Impulsamos proyecciones cinematográficas participativas en espacios comunitarios, centros culturales y territorios rurales. El cine como punto de encuentro, diálogo e intercambio de saberes.
        </p>
      </div>

      <!-- Metric Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-14">
        <div class="bg-sur-cream-light p-8 rounded-3xl border border-sur-olive/15 text-center space-y-2 shadow-sm hover:border-sur-olive/30 transition-all">
          <span class="font-sur-brand text-6xl text-sur-olive">+25</span>
          <h3 class="font-sans font-bold text-lg text-sur-olive-dark">Territorios Recorridos</h3>
          <p class="font-sans font-normal text-xs text-sur-olive/70">Comunidades rurales e indígenas conectadas.</p>
        </div>

        <div class="bg-sur-cream-light p-8 rounded-3xl border border-sur-olive/15 text-center space-y-2 shadow-sm hover:border-sur-olive/30 transition-all">
          <span class="font-sur-brand text-6xl text-sur-olive">+40</span>
          <h3 class="font-sans font-bold text-lg text-sur-olive-dark">Proyecciones Realizadas</h3>
          <p class="font-sans font-normal text-xs text-sur-olive/70">Funciones al aire libre y en malocas comunitarias.</p>
        </div>

        <div class="bg-sur-cream-light p-8 rounded-3xl border border-sur-olive/15 text-center space-y-2 shadow-sm hover:border-sur-olive/30 transition-all">
          <span class="font-sur-brand text-6xl text-sur-olive">100%</span>
          <h3 class="font-sans font-bold text-lg text-sur-olive-dark">Cine Independiente</h3>
          <p class="font-sans font-normal text-xs text-sur-olive/70">Cultura, memoria e identidad territorial.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Catálogo Preview Section -->
  <section id="catalogo" class="py-20 bg-sur-cream-light border-t border-sur-olive/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <div class="flex flex-col md:flex-row md:items-end justify-between mb-12 gap-4">
        <div>
          <span class="font-sans font-bold text-xs uppercase tracking-widest text-sur-olive">Muestra Audiovisual</span>
          <h2 class="font-sur-brand text-4xl sm:text-5xl text-sur-olive uppercase tracking-wide">
            Catálogo Disponible
          </h2>
        </div>
        <Button href="#catalogo" variant="sur-pill" size="md" className="font-sans font-bold">
          Ver Catálogo Completo
        </Button>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {filmCatalog.map((film) => (
          <div class="bg-sur-cream rounded-3xl overflow-hidden border border-sur-olive/15 shadow-md hover:shadow-xl transition-all duration-300 group flex flex-col justify-between">
            <div>
              <div class="aspect-[16/10] w-full overflow-hidden relative bg-slate-200">
                <img
                  src={film.image}
                  alt={film.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  onerror="this.onerror=null; this.src='/images/Recurso 8.webp';"
                />
                <span class="font-sans font-bold absolute top-3 left-3 bg-sur-green text-white text-[10px] px-3 py-1 rounded-full uppercase tracking-wider shadow-sm">
                  {film.category}
                </span>
              </div>
              <div class="p-6 space-y-2">
                <h3 class="font-sur-brand text-3xl text-sur-olive uppercase tracking-wide">{film.title}</h3>
                <p class="font-sans font-bold text-xs text-sur-olive/70">Director: {film.director} • {film.duration}</p>
              </div>
            </div>
            <div class="px-6 pb-6 pt-2">
              <Button href="#catalogo" variant="secondary" size="sm" className="w-full justify-center font-sans font-bold">
                Solicitar Función
              </Button>
            </div>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- CTA Section -->
  <section id="sedes" class="py-20 bg-sur-olive text-sur-cream relative overflow-hidden">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center space-y-6 relative z-10">
      <h2 class="font-sur-brand text-5xl sm:text-6xl uppercase tracking-wide">
        Lleva el cine a tu territorio
      </h2>
      <p class="font-sans font-normal text-sur-cream/90 text-base sm:text-lg max-w-2xl mx-auto leading-relaxed">
        ¿Te gustaría ser sede de proyecciones o conectar a tu comunidad? Organiza una función con el equipo de El Sur se Proyecta.
      </p>
      <div class="pt-2 flex justify-center">
        <Button href="#contact" variant="secondary" size="lg" className="bg-sur-cream text-sur-olive hover:bg-white border-0 font-sans font-bold">
          Sumar mi Comunidad
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
