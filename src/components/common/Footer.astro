---
const currentYear = new Date().getFullYear();

const footerSections = [
  {
    title: 'Navegación',
    links: [
      { name: 'Nosotros', href: '#nosotros' },
      { name: 'Catálogo de Películas', href: '#catalogo' },
      { name: 'Recursos', href: '#recursos' },
      { name: 'Sedes y Pantallas', href: '#sedes' },
      { name: 'Reporte de Impacto', href: '#reporte' },
    ],
  },
  {
    title: 'Comunidad',
    links: [
      { name: 'Red de CineComunario', href: '#' },
      { name: 'Convocatorias', href: '#' },
      { name: 'Talleres y Muestra', href: '#' },
      { name: 'Participa', href: '#' },
    ],
  },
  {
    title: 'Contacto',
    links: [
      { name: 'Escríbenos', href: '#' },
      { name: 'Prensa y Medios', href: '#' },
      { name: 'Preguntas Frecuentes', href: '#' },
    ],
  },
];
---

<footer class="bg-sur-cream border-t border-sur-olive/20 pt-16 pb-12 text-sur-olive text-sm">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-10 pb-12 border-b border-sur-olive/20">
      
      <!-- Brand column -->
      <div class="lg:col-span-2 space-y-4">
        <a href="/" class="flex items-center gap-3">
          <span class="font-sur-brand font-bold text-3xl text-sur-olive tracking-tight uppercase">
            El Sur se Proyecta
          </span>
        </a>
        <p class="text-sur-olive/80 max-w-sm leading-relaxed text-sm">
          Una invitación a que el cine viaje de territorio en territorio, de comunidad en comunidad, de pantalla en pantalla.
        </p>
      </div>

      <!-- Footer Columns -->
      {footerSections.map((section) => (
        <div class="space-y-3">
          <h3 class="text-sm font-bold text-sur-olive-dark tracking-wider uppercase">{section.title}</h3>
          <ul class="space-y-2">
            {section.links.map((link) => (
              <li>
                <a href={link.href} class="text-sur-olive/90 hover:text-sur-olive-dark font-medium transition-colors">
                  {link.name}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-sur-olive/70 font-medium">
      <p>© {currentYear} El Sur se Proyecta. Todos los derechos reservados. Desarrollado por ALVAROMEJIA.</p>
      <div class="flex items-center gap-6">
        <a href="#" class="hover:text-sur-olive-dark transition-colors">Política de Privacidad</a>
        <a href="#" class="hover:text-sur-olive-dark transition-colors">Términos de Uso</a>
      </div>
    </div>
  </div>
</footer>
